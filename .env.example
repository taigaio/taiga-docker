
# ========================================
# COOLIFY DEPLOYMENT SETTINGS
# ========================================
# For Coolify deployment:
# 1. Copy this file to .env: cp .env.example .env
# 2. Set TAIGA_SCHEME to "https" for production
# 3. Set TAIGA_DOMAIN to your Coolify-assigned domain (e.g., taiga.yourdomain.com)
# 4. Set WEBSOCKETS_SCHEME to "wss" for secure websockets
# 5. Change SECRET_KEY to a random, secure value (use: openssl rand -hex 32)
# 6. Update database and RabbitMQ passwords to secure values
# 7. Coolify will automatically set PORT if needed (default is 9000)
# 8. Configure email settings if you want to send emails via SMTP
# ========================================

# Port Configuration
PORT=9000  # Port for the gateway (Coolify will override this automatically)

# Taiga's URLs - Variables to define where Taiga should be served
TAIGA_SCHEME=https  # serve Taiga using "http" or "https" (secured) connection
TAIGA_DOMAIN=your-domain.com  # Taiga's base URL - CHANGE THIS to your Coolify domain
SUBPATH="" # it'll be appended to the TAIGA_DOMAIN (use either "" or a "/subpath")
WEBSOCKETS_SCHEME=wss  # events connection protocol (use either "ws" or "wss")

# Taiga's Secret Key - Variable to provide cryptographic signing
SECRET_KEY="change-me-to-random-value"  # IMPORTANT: Generate with: openssl rand -hex 32

# Taiga's Database settings - Variables to create the Taiga database and connect to it
POSTGRES_USER=taiga  # user to connect to PostgreSQL
POSTGRES_PASSWORD=change-me-to-secure-password  # IMPORTANT: Change this to a secure password for production!

# Taiga's SMTP settings - Variables to send Taiga's emails to the users
EMAIL_BACKEND=console  # use an SMTP server or display the emails in the console (either "smtp" or "console")
EMAIL_HOST=smtp.host.example.com  # SMTP server address
EMAIL_PORT=587   # default SMTP port
EMAIL_HOST_USER=user  # user to connect the SMTP server
EMAIL_HOST_PASSWORD=password  # SMTP user's password
EMAIL_DEFAULT_FROM=changeme@example.com  # email address for the automated emails

# EMAIL_USE_TLS/EMAIL_USE_SSL are mutually exclusive (only set one of those to True)
EMAIL_USE_TLS=True  # use TLS (secure) connection with the SMTP server
EMAIL_USE_SSL=False  # use implicit TLS (secure) connection with the SMTP server

# Taiga's RabbitMQ settings - Variables to leave messages for the realtime and asynchronous events
RABBITMQ_USER=taiga  # user to connect to RabbitMQ
RABBITMQ_PASS=change-me-to-secure-password  # IMPORTANT: Change this to a secure password for production!
RABBITMQ_VHOST=taiga  # RabbitMQ container name
RABBITMQ_ERLANG_COOKIE=change-me-to-random-value  # IMPORTANT: Generate with: openssl rand -hex 32

# Taiga's Attachments - Variable to define how long the attachments will be accesible
ATTACHMENTS_MAX_AGE=360  # token expiration date (in seconds)

# Taiga's Telemetry - Variable to enable or disable the anonymous telemetry
ENABLE_TELEMETRY=True
